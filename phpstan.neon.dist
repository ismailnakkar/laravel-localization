includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 7
    paths:
        - src
        - tests
    # Constructors re-check config values despite their PHPDoc types.
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Fixture views are added at runtime; Larastan can't see them.
        -
            identifier: argument.type
            message: '#view-string#'
            path: tests/*
